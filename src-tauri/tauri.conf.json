{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelvo",
  "version": "0.3.0",
  "identifier": "com.tryopendata.kelvo",
  "build": {
    "beforeDevCommand": "bun run dev:fast",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utilities",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2ODFDMzU4QTlDMTQ4MTUKUldRVlNNR3BXTU9CVmo0NXR4dkh4MGZxdW1QT3ROSVRrWk4rRkh0OGxPamh3VXB1eEU5dXd5UVgK",
      "endpoints": [
        "https://github.com/tryopendata/kelvo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
